# Base de las llamadas a la API desde el navegador. "/" = mismo origen: Next reenvía
# /api/* al backend (rewrite en next.config.ts), así la cookie de sesión viaja sola.
NEXT_PUBLIC_API_URL=/

# Dirección del backend FastAPI vista DESDE EL SERVIDOR de Next (usada por el rewrite).
# En Docker es la red interna; en desarrollo local:
#   API_INTERNA_URL=http://localhost:7860 pnpm dev
API_INTERNA_URL=http://localhost:7860

# Enlace al repositorio público del proyecto (se muestra en el pie de página)
NEXT_PUBLIC_REPO_URL=https://github.com/usuario/repositorio
